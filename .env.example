# ── Family ────────────────────────────────────────────────────────────────────
FAMILY_NAME=The Srinivasan Family
PARENT_NAME=Mom
PARENT_EMAIL=your@email.com
CHILDREN=Avery,Jordan

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Nudge dispatcher ──────────────────────────────────────────────────────────
