NUDGE_SCAN_MINUTE=0

# ── LangSmith (optional) ──────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=hearth

# ── Paths ────────────────────────────────────────────────────────────────────
DATA_DIR=data
API_PORT=8000
